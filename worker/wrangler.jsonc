{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evi-station-alert",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "STATE"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
